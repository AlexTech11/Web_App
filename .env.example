# Copy to .env.local and fill in from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Public origin of the site — used in auth email links (production: your Vercel/custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Phase 4 integrations (all OFF by default; enable when domain + keys are ready) ──

# Cloudflare Turnstile — spam protection on public forms
NEXT_PUBLIC_TURNSTILE_ENABLED=false
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Per-IP rate limiting on submissions (needs Upstash Redis)
RATE_LIMIT_ENABLED=false
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Paystack — activation / reservation / booking payments
NEXT_PUBLIC_PAYSTACK_ENABLED=false
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_SECRET_KEY=sk_test_...            (server-only, set in Vercel — never commit)
# SUPABASE_SERVICE_ROLE_KEY=                 (server-only, for the payment webhook to mark paid)
# Fee defaults (Naira) — overridden by admin-editable values in the settings table
# PAYSTACK_ACTIVATION_FEE_NGN=5000
# PAYSTACK_RESERVATION_FEE_NGN=5000
# PAYSTACK_RENTAL_FEE_NGN=5000
